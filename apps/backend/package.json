{
  "private": true,
  "type": "module",
  "name": "backend",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "build": "prisma generate && tsdown",
    "postinstall": "prisma generate",
    "start": "bun --env-file=.env.production dist/index.mjs",
    "dev:turso": "bun --env-file=.env.production src/server.ts",
    "db:deploy": "bun --env-file=.env.production prisma migrate deploy",
    "seed:prod": "bun --env-file=.env.production prisma/seed.ts",
    "seed:pg": "bun --env-file=.env.production prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/client-ssm": "^3.1057.0",
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@libsql/client": "0.8.1",
    "@prisma/adapter-libsql": "^7.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.5.0",
    "bcryptjs": "^3.0.3",
    "elysia": "^1.4.28",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.9.1",
    "prisma": "^7.5.0",
    "tsdown": "^0.21.7"
  }
}